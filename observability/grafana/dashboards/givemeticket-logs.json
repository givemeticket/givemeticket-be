          "legendFormat": "2xx·3xx"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service=\"$service\", env=\"$env\", log_type=\"RESPONSE\"} | json | status >= 400 and status < 500 [$__auto]))",
