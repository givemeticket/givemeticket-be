logging {
  level  = "warn"
  format = "logfmt"
}

// backend 컨테이너와 같은 backend-logs 볼륨을 read-only 로 마운트해서 tail 한다.
// gc.log / hs_err_pid*.log 와 섞이지 않도록 app 하위 디렉터리만 본다.
local.file_match "app_logs" {
  path_targets = [{ __path__ = "/logs/app/*.log" }]
  sync_period  = "10s"
}

loki.source.file "app" {
  targets       = local.file_match.app_logs.targets
  forward_to    = [loki.process.app.receiver]
  tail_from_end = false
}

loki.process "app" {
  forward_to = [loki.write.default.receiver]

  // logback 이 이미 JSON 한 줄로 뱉으므로 multiline 스티칭이 필요 없다.
  // "@timestamp" 는 JMESPath 에서 특수문자라 따옴표로 감싸야 한다.
  stage.json {
    expressions = {
      severity = "severity",
      log_type = "logType",
      ts       = "\"@timestamp\"",
    }
  }

  // 로그 시각은 Alloy 가 파일을 읽은 시각이 아니라 logback 이 찍은 시각을 쓴다.
  stage.timestamp {
    source = "ts"
    format = "RFC3339"
  }

  // 검색에 쓸 저카디널리티 필드만 라벨로 승격한다.
  // uri, request_id 같은 고카디널리티 필드는 절대 라벨로 올리지 않는다 (Loki 인덱스 폭발).
  stage.labels {
    values = {
      level    = "severity",
      log_type = "log_type",
    }
  }

  stage.static_labels {
    values = {
      service = "givemeticket-api",
      env     = sys.env("ALLOY_ENV"),
    }
  }
}

// GC 로그도 같은 볼륨에 있으니 함께 tail 한다. Grafana 에서 GC 지표 그래프와
// "GC(12) Pause Young ... 13ms" 원문을 한 화면에서 대조하기 위해서다.
// 상세 로그(gc-detail.log)는 양이 많아 보내지 않는다. 필요하면 컨테이너에서 직접 읽는다.
local.file_match "gc_logs" {
  path_targets = [{ __path__ = "/logs/gc.log" }]
  sync_period  = "10s"
}

loki.source.file "gc" {
  targets    = local.file_match.gc_logs.targets
  forward_to = [loki.process.gc.receiver]
  // gc.log 는 볼륨에 며칠씩 쌓여 있다. 처음 붙을 때 과거를 다 밀어 넣으면
  // Loki 가 reject_old_samples 로 400 을 뱉으므로 끝에서부터 읽는다.
  tail_from_end = true
}

loki.process "gc" {
  forward_to = [loki.write.default.receiver]

  // [2026-08-16T04:56:25.511+0000][26885.728s][info][gc] GC(42) Pause Young ...
  stage.regex {
    expression = "^\\[(?P<ts>[^\\]]+)\\]\\[[^\\]]+\\]\\[(?P<level>[^\\]]+)\\]"
  }

  // -Xlog 의 time 데코레이터는 오프셋을 +0000 처럼 콜론 없이 찍어서 RFC3339 로는 안 읽힌다.
  stage.timestamp {
    source = "ts"
    format = "2006-01-02T15:04:05.000-0700"
  }

  stage.labels {
    values = { level = "level" }
  }

  stage.static_labels {
    values = {
      service  = "givemeticket-jvm",
      log_type = "gc",
      env      = sys.env("ALLOY_ENV"),
    }
  }
}

loki.write "default" {
  endpoint {
    url        = "http://loki:3100/loki/api/v1/push"
    batch_wait = "1s"
    batch_size = "1MiB"
  }
}
