MYSQL_DATABASE=givemeticket
MYSQL_USER=givemeticket
MYSQL_PASSWORD=givemeticket
MYSQL_ROOT_PASSWORD=root

BACKEND_PORT=18080
PAYMENT_MOCK_PORT=18081
MYSQL_PORT=3307
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

DB_POOL_SIZE=10

# ---- 인증 ----
# HS256 서명 키. 32바이트 이상이어야 한다.
#   openssl rand -base64 48
JWT_SECRET_KEY=local-development-only-secret-key-32bytes
# 액세스 토큰 만료 (기본 7일)
JWT_ACCESS_TOKEN_EXPIRATION_MS=604800000

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
# 앱 키이자 ID 토큰의 aud 검증 값이라 실제 값이 없으면 로그인이 동작하지 않는다.
KAKAO_REST_API_KEY=
# 콘솔 > 보안 에서 Client Secret 을 '사용함' 으로 켰을 때만 채운다.
# 켜 두고 비워 두면 앱 키가 맞아도 invalid_client 로 거절된다.
KAKAO_CLIENT_SECRET=
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > Admin 키
# 회원 탈퇴 시 카카오 연결 끊기에 쓴다. 비워 두면 우리 DB 만 지우고 카카오 연결은 남는다.
# 앱 전체를 대리하는 키라 절대 프론트로 내려가면 안 된다.
KAKAO_ADMIN_KEY=

# 네이버 개발자센터 > 내 애플리케이션 > 개요
# 카카오와 달리 시크릿이 필수다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

PAYMENT_DELAY_MS=0
PAYMENT_JITTER_MS=0
PAYMENT_ERROR_RATE=0.0
PAYMENT_TIMEOUT_RATE=0.0
PAYMENT_DECLINE_RATE=0.0
PAYMENT_CANCEL_ERROR_RATE=0.0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
