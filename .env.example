MYSQL_DATABASE=givemeticket
MYSQL_USER=givemeticket
MYSQL_PASSWORD=givemeticket
MYSQL_ROOT_PASSWORD=root

BACKEND_PORT=18080
PAYMENT_MOCK_PORT=18081
MYSQL_PORT=3307
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

DB_POOL_SIZE=10

# ---- JVM 힙 / GC (실험용) ----
# 바꾼 뒤 docker compose up -d backend 만 하면 반영된다. 재빌드는 필요 없다.
# 자세한 실험 방법은 docs/gc-experiment.md 참고.
#   힙을 컨테이너 비율이 아니라 고정값으로: JVM_HEAP_OPTS=-Xms256m -Xmx256m
#   GC 교체: -XX:+UseParallelGC / -XX:+UseSerialGC / -XX:+UseZGC -XX:+ZGenerational
JVM_HEAP_OPTS=-XX:InitialRAMPercentage=70.0 -XX:MaxRAMPercentage=70.0
JVM_GC_OPTS=-XX:+UseG1GC
JAVA_OPTS_EXTRA=
# 컨테이너에 주는 자원. CPU 수는 GC 워커 스레드 수를 결정한다.
# ---- 캠페인 캐시 ----
# none: 캐시 없음 / redis: Redis 캐시만 / local: 로컬 캐시 + Redis + pub/sub 무효화
CAMPAIGN_CACHE_MODE=local
CAMPAIGN_CACHE_TTL=10m
# 로컬 캐시는 pub/sub 방송을 놓칠 수 있어서 TTL 이 최후의 보루다. 짧게 잡는다.
CAMPAIGN_LOCAL_CACHE_TTL=30s
# 항목당 힙 점유는 안내문 길이에 비례한다 (800자 2.2KB, 상한 5,000자 10.5KB).
# 6,000개는 최악의 경우에도 힙 718MB 의 8.6% 다.
CAMPAIGN_LOCAL_CACHE_MAX_SIZE=6000
# 두 번째 인스턴스(--profile multi)용 포트
BACKEND2_PORT=18082

BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=1.0

# ---- 인증 ----
# HS256 서명 키. 32바이트 이상이어야 한다.
#   openssl rand -base64 48
JWT_SECRET_KEY=local-development-only-secret-key-32bytes
# 액세스 토큰 만료 (기본 7일)
JWT_ACCESS_TOKEN_EXPIRATION_MS=604800000

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
# 앱 키이자 ID 토큰의 aud 검증 값이라 실제 값이 없으면 로그인이 동작하지 않는다.
KAKAO_REST_API_KEY=
# 콘솔 > 보안 에서 Client Secret 을 '사용함' 으로 켰을 때만 채운다.
# 켜 두고 비워 두면 앱 키가 맞아도 invalid_client 로 거절된다.
KAKAO_CLIENT_SECRET=
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > Admin 키
# 회원 탈퇴 시 카카오 연결 끊기에 쓴다. 비워 두면 우리 DB 만 지우고 카카오 연결은 남는다.
# 앱 전체를 대리하는 키라 절대 프론트로 내려가면 안 된다.
KAKAO_ADMIN_KEY=

# 네이버 개발자센터 > 내 애플리케이션 > 개요
# 카카오와 달리 시크릿이 필수다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

PAYMENT_DELAY_MS=0
PAYMENT_JITTER_MS=0
PAYMENT_ERROR_RATE=0.0
PAYMENT_TIMEOUT_RATE=0.0
PAYMENT_DECLINE_RATE=0.0
PAYMENT_CANCEL_ERROR_RATE=0.0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# 부하 실험을 며칠에 걸쳐 비교하려면 길게 잡는다.
PROMETHEUS_RETENTION=7d
